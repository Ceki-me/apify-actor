# Ceki credentials — never commit this file.
#
# Create an agent key at https://ceki.me (API keys section) and paste it here
# for local runs.
CEKI_TOKEN=

# Which browser to drive. Find the ID in your Ceki dashboard under "My browsers".
CEKI_BROWSER_ID=

# Optional overrides — leave empty to use the SDK defaults (production).
CEKI_API_URL=
CEKI_RELAY_URL=
